{
  "manifest_version": 3,
  "name": "Org Switcher for GitHub",
  "version": "1.0.0",
  "description": "Jump to any of your GitHub orgs and your recent or favourite repos in one click. Unofficial, not made by GitHub.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Org Switcher for GitHub",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
